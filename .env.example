# Copy to .env.local and fill in. Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465,
# SMTP_PASS = a Google "App password" (Google Account > Security > 2-Step Verification > App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
# Where new lead alerts go (comma-separate for several)
LEAD_NOTIFY_TO=you@gmail.com
MAIL_FROM_NAME=Click Mine Media
